{
  "preset": "Tibia Idle (Canary + Client)",
  "selected_roots": [
    "Canary",
    "Client"
  ],
  "extensions": [
    ".cpp",
    ".hpp",
    ".h",
    ".lua",
    ".otui",
    ".otmod",
    ".xml",
    ".json",
    ".md",
    ".txt"
  ],
  "special_filenames": [
    "CMakeLists.txt",
    "Dockerfile",
    "Makefile",
    ".gitignore"
  ],
  "ignore_dirs": [
    ".git",
    ".idea",
    ".vs",
    ".vscode",
    "__pycache__",
    "node_modules",
    "Library",
    "Temp",
    "Logs",
    "UserSettings",
    "bin",
    "obj",
    "build",
    "Build",
    "dist",
    "out",
    "target",
    "vendor",
    "ProjectBible",
    "ChatGPTProject",
    "research-assets"
  ],
  "ignore_globs": [
    "*.exe",
    "*.dll",
    "*.pdb",
    "*.zip",
    "*.7z",
    "*.rar",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.webp",
    "*.mp3",
    "*.ogg",
    "*.wav",
    "*.mp4",
    "*.otbm",
    "*.spr",
    "*.dat",
    "*.glb",
    "*.gltf",
    "*.fbx",
    "*.pdf",
    "*.docx",
    "*.xlsx",
    "*.pptx",
    "*.db",
    "*.sqlite",
    "*.map",
    "*.pak",
    "*.cache",
    "*.log"
